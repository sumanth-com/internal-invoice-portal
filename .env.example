# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Server only. Used to invite portal users. Never expose this in browser code.
SUPABASE_SECRET_KEY=your-secret-key
# Server only. Used to send email through Resend. Never expose this in browser code.
RESEND_API_KEY=your-resend-api-key
# Server only. Verified sender. Never expose this in browser code.
RESEND_FROM_EMAIL="iFranchise <invoices@yourdomain.com>"
